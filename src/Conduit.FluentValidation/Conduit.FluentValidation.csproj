<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ConduitAotCompatible>true</ConduitAotCompatible>
    <IsPackable>true</IsPackable>
    <PackageId>Conduit.FluentValidation</PackageId>
    <Description>Optional FluentValidation adapter for Conduit. Implemented in-house; does not depend on any third-party mediator integration package.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" />
  </ItemGroup>

  <!-- 编译期需要内核心类型 -->
  <ItemGroup>
    <ProjectReference Include="../Conduit.Abstractions/Conduit.Abstractions.csproj" PrivateAssets="all" />
    <ProjectReference Include="../Conduit.Core/Conduit.Core.csproj" PrivateAssets="all" />
    <ProjectReference Include="../Conduit.DependencyInjection/Conduit.DependencyInjection.csproj" PrivateAssets="all" />
  </ItemGroup>

  <!-- 包依赖只指向主包（区间），避免暴露内部程序集名作为包 ID -->
  <ItemGroup>
    <ProjectReference Include="../Conduit/Conduit.csproj" Version="[1.0.0, 2.0.0)" />
  </ItemGroup>

  <!-- 与主包一致：把对 Conduit 的依赖落成 [1.0.0, 2.0.0) 区间 -->
  <Target Name="ConduitPinMainPackageVersionRange" AfterTargets="_GetProjectReferenceVersions">
    <ItemGroup>
      <_ProjectReferencesWithVersions Update="$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\Conduit\Conduit.csproj'))">
        <ProjectVersion>[1.0.0, 2.0.0)</ProjectVersion>
      </_ProjectReferencesWithVersions>
    </ItemGroup>
  </Target>

</Project>
